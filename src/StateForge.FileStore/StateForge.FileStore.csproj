<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StateForge.FileStore</RootNamespace>
    <AssemblyName>StateForge.FileStore</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.16.2</Version>
    <Authors>StateForge</Authors>
    <Company>StateForge</Company>
    <Product>StateForge</Product>
    <Description>Persistent session-state storage components for ASP.NET and ASP.NET Core.</Description>


    <PackageId>StateForge.FileStore</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
      <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
      <PackageTags>stateforge;session-state;aspnet;aspnetcore;distributed-cache;filestore;stfg2</PackageTags>
      <PackageProjectUrl>https://github.com/stateforge/stateforge</PackageProjectUrl>
      <RepositoryUrl>https://github.com/stateforge/stateforge</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StateForge.Core\StateForge.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="4.7.0" />
      <ProjectReference Include="..\StateForge.Format\StateForge.Format.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
