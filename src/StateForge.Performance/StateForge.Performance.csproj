<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StateForge.Performance</RootNamespace>
    <AssemblyName>StateForge.Performance</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.30.4</Version>
    <PackageId>StateForge.Performance</PackageId>
    <Description>Performance snapshot and sharding analysis helpers for StateForge.</Description>
    <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
    <PackageTags>stateforge;performance;benchmark;sharding;snapshot-cache</PackageTags>
    <PackageProjectUrl>https://github.com/stateforge/stateforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stateforge/stateforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StateForge.FileStore\StateForge.FileStore.csproj" />
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
