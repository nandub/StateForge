<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StateForge.Snapshots</RootNamespace>
    <AssemblyName>StateForge.Snapshots</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.26.1</Version>
    <PackageId>StateForge.Snapshots</PackageId>
    <Description>Snapshot, restore, scheduling, promotion, and failover helpers for StateForge.</Description>
    <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
    <PackageTags>stateforge;snapshot;restore;promotion;failover;replication</PackageTags>
    <PackageProjectUrl>https://github.com/stateforge/stateforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stateforge/stateforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StateForge.Replication\StateForge.Replication.csproj" />
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
