<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StateForge.Format</RootNamespace>
    <AssemblyName>StateForge.Format</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <Version>0.21.0</Version>

    <PackageId>StateForge.Format</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
      <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
      <PackageTags>stateforge;session-state;aspnet;aspnetcore;distributed-cache;filestore;stfg2</PackageTags>
      <PackageProjectUrl>https://github.com/stateforge/stateforge</PackageProjectUrl>
      <RepositoryUrl>https://github.com/stateforge/stateforge</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
