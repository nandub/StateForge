<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StateForge.Telemetry</RootNamespace>
    <AssemblyName>StateForge.Telemetry</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <Version>0.16.2</Version>
    <Authors>StateForge</Authors>
    <Company>StateForge</Company>
    <Product>StateForge</Product>
    <Description>Telemetry primitives, EventSource events, and lightweight metrics for StateForge.</Description>

    <PackageId>StateForge.Telemetry</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
      <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
      <PackageTags>stateforge;session-state;aspnet;aspnetcore;distributed-cache;filestore;stfg2</PackageTags>
      <PackageProjectUrl>https://github.com/stateforge/stateforge</PackageProjectUrl>
      <RepositoryUrl>https://github.com/stateforge/stateforge</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
