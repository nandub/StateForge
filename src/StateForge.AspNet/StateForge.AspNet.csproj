<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>StateForge.AspNet</RootNamespace>
    <AssemblyName>StateForge.AspNet</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.35.0</Version>
    <Authors>StateForge</Authors>
    <Company>StateForge</Company>
    <Product>StateForge</Product>
    <Description>Persistent session-state storage components for ASP.NET and ASP.NET Core.</Description>


    <PackageId>StateForge.AspNet</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
      <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
      <PackageTags>stateforge;session-state;aspnet;aspnetcore;distributed-cache;filestore;stfg2</PackageTags>
      <PackageProjectUrl>https://github.com/nandub/StateForge</PackageProjectUrl>
      <RepositoryUrl>https://github.com/nandub/StateForge</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
    <ProjectReference Include="..\StateForge.Core\StateForge.Core.csproj" />
    <ProjectReference Include="..\StateForge.FileStore\StateForge.FileStore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
