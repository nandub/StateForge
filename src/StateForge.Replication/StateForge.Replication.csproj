<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>StateForge.Replication</RootNamespace>
    <AssemblyName>StateForge.Replication</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.21.0</Version>
    <PackageId>StateForge.Replication</PackageId>
    <Description>Distributed replication foundations for StateForge stores.</Description>
    <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
    <PackageTags>stateforge;replication;distributed;session-state;farm-mode</PackageTags>
    <PackageProjectUrl>https://github.com/stateforge/stateforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stateforge/stateforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StateForge.FileStore\StateForge.FileStore.csproj" />
    <None Include="..\..\README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
